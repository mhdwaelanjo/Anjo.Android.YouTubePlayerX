<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net7.0-android;net6.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<NoWarn>1701;1702;CS0618;SYSLIB0039;</NoWarn>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.YouTubePlayerX</PackageId>
		<PackageVersion>1.0.8</PackageVersion>
		<AssemblyVersion>1.0.8</AssemblyVersion>
		<FileVersion>1.0.8</FileVersion>
		<Version>1.0.8</Version>
		<Title>Anjo Android YouTube Player</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.YouTubePlayerX</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Description>YouTube Player API Reference for iframe Embeds for .NET Android (formerly Xamarin.Android) for AndroidX library - Wael Anjo</Description>
		<PackageReleaseNotes>YouTube Player API Reference for iframe Embeds v1.0.8</PackageReleaseNotes>
		<Copyright>Copyright (c) 2023 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, youtube, youtubeplayer, YouTubeAndroidPlayer, Video Player</PackageTags>
		<Summary>The YouTube Player API Reference for iframe Embeds enables you to incorporate video playback functionality into your Android applications.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<ProguardConfiguration Include="proguard-rules.pro" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.1.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.6.1.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.6.1.2" />
		<PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.3.0.2" />
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.9.0.1" />
	</ItemGroup>
</Project>